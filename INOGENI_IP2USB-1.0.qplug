  table.insert(ctrls, {Name = "CameraSelect", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "CameraSelectButton", ControlType = "Button", ButtonType = "StateTrigger", Min = 0, Max = 1, Count = 10, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzUp", ControlType = "Button", ButtonType = "Momentary", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzDown", ControlType = "Button", ButtonType = "Momentary", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzLeft", ControlType = "Button", ButtonType = "Momentary", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzRight", ControlType = "Button", ButtonType = "Momentary", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzZoomIn", ControlType = "Button", ButtonType = "Momentary", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzZoomOut", ControlType = "Button", ButtonType = "Momentary", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  
  table.insert(ctrls, {Name = "PtzPresetNumber", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzSetPreset", ControlType = "Button", ButtonType = "Trigger", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "PtzRecallPreset", ControlType = "Button", ButtonType = "Trigger", Min = 0, Max = 1, Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "HdmiResolution", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "StandByMode", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "UsbInputAudio", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "UsbOutputAudio", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "AecAudio", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "AudioSwitchMode", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  table.insert(ctrls, {Name = "NdiServer", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both"})
