-- Plugin: INOGENI IP2USB
-- initial release IP2USB V.1.3.3

PluginInfo =
{
  Name = "INOGENI~IP2USB v1",
  Version = "1.0",
  BuildVersion = "1.0.0.0",
  Id = "b2e6e2e2-4c7a-4e2e-8b7a-2e8e2e2e2e2e",
  Author = "Daniel",
  Description = "Plugin for INOGENI IP2USB",
  Manufacturer = "INOGENI",
  Model = "IP2USB"
}

function GetColor(props)
  return {215, 80, 45}
end

function GetPrettyName(props)
  return "INOGENI\x0d\x0aIP2USB\x0d\x0av" .. PluginInfo.Version
end

function GetProperties()
  local props = {}
  table.insert(props,
  {
    Name = "Debug Print",
    Type = "enum",
    Choices = {"None", "Tx/Rx", "Tx", "Rx", "Function Calls", "Comm", "All"},
    Value = "None"
  })
  table.insert(props,
  {
    Name = "Control Mode",
    Type = "enum",
    Choices = {"Ethernet", "Serial"},
    Value = "Ethernet"
  })
  table.insert(props,
  {
    Name = "API Token",
    Type = "enum",
    Choices = {"Inactive", "Active"},
    Value = "Inactive"
  })
  table.insert(props,
  {
    Name = "Polling Interval (s)",
    Type = "enum",
    Choices = {"0.5", "1", "2", "3", "5", "10"},
    Value = "2"
  })
  return props
end

function GetPins(props)
  local pins = {}
  if props["Control Mode"].Value == "Serial" then
    table.insert(pins,
    {
      Name = "input",
      Direction = "input",
      Domain = "serial"
    })
  end
  return pins
end

function RectifyProperties(props)
  if props["Control Mode"].Value == "Serial" then
    props["API Token"].IsHidden = true
  end
  return props
end

function GetPageNames(props)
  return {"Connection", "Cameras", "PTZ", "Status", "Settings", "About"}
end

function GetPages(props)
  local pages = {}
  for _, pgeName in ipairs(GetPageNames(props)) do
    table.insert(pages, {name = pgeName})
  end
  return pages
end

--- *** Define here the Control Part (Controls, Buttons, Pins...) *** ---
----------------------------------------------------------------------------------------------    
LogoInogeni  = ""


function GetControls(props)
  local ctrls = {}

  if props["Control Mode"].Value == "Ethernet" then
    table.insert(ctrls, {Name = "IPAddress", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both"})
    table.insert(ctrls, {Name = "APIToken", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both"})
  else
    table.insert(ctrls, {Name = "SerialBaud", ControlType = "Text", ControlUnit = "ComboBox", Count = 1, UserPin = true, PinStyle = "Both"})
  end

  table.insert(ctrls, {Name = "Status", ControlType = "Indicator", IndicatorType = "Status", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "Firmware", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "MACAddress", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatIPAddress", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatSubnet", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatGateway", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatSerial", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatTemperature", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatDhcp", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatCdcNcmIp", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
  table.insert(ctrls, {Name = "StatUsbVideo", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output"})
