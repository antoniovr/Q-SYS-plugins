if Controls then
  local Status = Controls.Status
  local Connected = Controls.Connected
  local DisplayOn = Controls.DisplayOn
  local DisplayOnCommand = Controls.DisplayOnCommand
  local DisplayOffCommand = Controls.DisplayOffCommand
  local DisplayToggleCommand = Controls.DisplayToggleCommand
  local Brightness = Controls.Brightness
  local BrightnessFB = Controls.BrightnessFB
  local Preset = Controls.Preset
  local CurrentPreset = Controls.CurrentPreset
  local LastCommand = Controls.LastCommand
  local IPAddress = Controls.IPAddress
  local Port = Controls.Port
  local AutoConnect = Controls.AutoConnect
  local Reconnect = Controls.Reconnect

  local StatusState = {
    OK = 0,
    COMPROMISED = 1,
    FAULT = 2,
    NOTPRESENT = 3,
    MISSING = 4,
    INITIALIZING = 5
  }

  local debugMode = Properties["Debug Print"].Value
  local debugTx = debugMode == "Tx/Rx" or debugMode == "Tx" or debugMode == "All"
  local debugRx = debugMode == "Tx/Rx" or debugMode == "Rx" or debugMode == "All"

  local tcp = TcpSocket.New()
  tcp.ReadTimeout = 0
  tcp.WriteTimeout = 3
  tcp.ReconnectTimeout = 5

  local ackTimer = Timer.New()
  local brightnessTimer = Timer.New()
  local reconnectTimer = Timer.New()
  local commandQueue = {}
  local pending = nil
  local rxBuffer = ""
  local suppressEvents = false
  local confirmedDisplayOn = DisplayOn.Boolean
  local requestedDisplayOn = DisplayOn.Boolean

  local function SetStatus(state, message)
    Status.Value = StatusState[state]
    Status.String = message or state
  end

  local function BytesToHex(data)
    local out = {}
    for i = 1, #data do
      out[#out + 1] = string.format("%02X", string.byte(data, i))
    end
    return table.concat(out, " ")
  end

  local function BuildPacket(registerBytes, dataBytes)
    local content = {
      0x00, 0x00, 0xFE, 0xFF, 0x01,
      0xFF, 0xFF, 0xFF, 0x01, 0x00
    }

    for _, value in ipairs(registerBytes) do
      content[#content + 1] = value
    end

    local length = #dataBytes
    content[#content + 1] = length % 256
    content[#content + 1] = math.floor(length / 256)

    for _, value in ipairs(dataBytes) do
      content[#content + 1] = value
    end

    local checksum = 0x5555
    for _, value in ipairs(content) do
      checksum = (checksum + value) % 0x10000
    end

    local packet = { 0x55, 0xAA }
    for _, value in ipairs(content) do
      packet[#packet + 1] = value
    end
    packet[#packet + 1] = checksum % 256
    packet[#packet + 1] = math.floor(checksum / 256)

    return string.char(table.unpack(packet))
  end

  local function RegisterMatches(frame, registerBytes)
    for i = 1, 4 do
      if string.byte(frame, 12 + i) ~= registerBytes[i] then
        return false
      end
    end
    return true
  end

  local function FrameChecksumValid(frame, dataLength)
    local contentSum = 0
    local contentEnd = 18 + dataLength
    for i = 3, contentEnd do
      contentSum = (contentSum + string.byte(frame, i)) % 0x10000
    end
    local received = string.byte(frame, 19 + dataLength)
      + (string.byte(frame, 20 + dataLength) * 256)

    -- NovaStar documentation describes 0x5555 as the checksum base. Actual
    -- MX30 ACK packets use an additional 0x00FF offset (base 0x5654).
    -- Accept both formats to remain compatible with different COEX firmware.
    local documentedChecksum = (contentSum + 0x5555) % 0x10000
    local mx30AckChecksum = (contentSum + 0x5654) % 0x10000
    return received == documentedChecksum or received == mx30AckChecksum
  end

  local ProcessQueue

  local function CommandSucceeded(command)
    if command.kind == "display" then
      confirmedDisplayOn = command.on
      suppressEvents = true
      DisplayOn.Boolean = command.on
      suppressEvents = false
    elseif command.kind == "brightness" then
      BrightnessFB.Value = command.percent
    elseif command.kind == "preset" then
      CurrentPreset.Value = command.preset
    end

    LastCommand.String = "OK - " .. command.description
    SetStatus("OK", "Connected - last command acknowledged")
  end

  local function FinishPending(success, errorMessage)
    if not pending then return end

    ackTimer:Stop()
    local completed = pending
    pending = nil

    if success then
      CommandSucceeded(completed)
    else
      if completed.kind == "display" then
        suppressEvents = true
        DisplayOn.Boolean = confirmedDisplayOn
        suppressEvents = false
      end
      LastCommand.String = "ERROR - " .. completed.description .. ": " .. (errorMessage or "no ACK")
      SetStatus("COMPROMISED", "Connected, but command was not acknowledged")
    end

    ProcessQueue()
  end

  local function SendPending()
    if not pending or not tcp.IsConnected then return end
    if debugTx then
      print("TX [" .. pending.description .. "]: " .. BytesToHex(pending.packet))
    end
    tcp:Write(pending.packet)
    ackTimer:Stop()
    ackTimer:Start(1.5)
  end

  ProcessQueue = function()
    if pending or not tcp.IsConnected or #commandQueue == 0 then return end
    pending = table.remove(commandQueue, 1)
    pending.attempts = 1
    SendPending()
  end

  local function QueueCommand(command)
    if command.kind == "brightness" or command.kind == "display" then
      for i = #commandQueue, 1, -1 do
        if commandQueue[i].kind == command.kind then
          table.remove(commandQueue, i)
        end
      end
    end

    command.packet = BuildPacket(command.register, command.data)
    commandQueue[#commandQueue + 1] = command
    LastCommand.String = "Queued - " .. command.description
    ProcessQueue()
  end

  local function SetDisplay(on)
    requestedDisplayOn = on
    QueueCommand({
      kind = "display",
      on = on,
      description = on and "Display normal" or "Display blackout",
      register = { 0x00, 0x01, 0x00, 0x02 },
      data = { on and 0x00 or 0xFF }
    })
  end

  local function SetBrightness(percent)
    percent = math.max(0, math.min(100, math.floor(percent + 0.5)))
    local raw = math.floor((percent * 255 / 100) + 0.5)
    QueueCommand({
      kind = "brightness",
      percent = percent,
      description = "Brightness " .. percent .. "%",
      register = { 0x01, 0x00, 0x00, 0x02 },
      data = { raw }
    })
  end

  local function RecallPreset(number)
    QueueCommand({
      kind = "preset",
      preset = number,
      description = "Preset " .. number,
      register = { 0x02, 0x00, 0x00, 0x0A },
      data = { number }
    })
  end

  ackTimer.EventHandler = function()
    ackTimer:Stop()
    if not pending then return end

    if pending.attempts < 2 and tcp.IsConnected then
      pending.attempts = pending.attempts + 1
      if debugTx then print("No ACK; retrying " .. pending.description) end
      SendPending()
    else
      FinishPending(false, "timeout waiting for ACK")
    end
  end

  brightnessTimer.EventHandler = function()
    brightnessTimer:Stop()
    SetBrightness(Brightness.Value)
  end

  local function ParseFrames()
    while true do
      local headerAt = string.find(rxBuffer, "\xAA\x55", 1, true)
      if not headerAt then
        if #rxBuffer > 0 and string.byte(rxBuffer, #rxBuffer) == 0xAA then
          rxBuffer = string.sub(rxBuffer, #rxBuffer)
        else
          rxBuffer = ""
        end
        return
      end

      if headerAt > 1 then
        rxBuffer = string.sub(rxBuffer, headerAt)
      end

      if #rxBuffer < 18 then return end

      local dataLength = string.byte(rxBuffer, 17) + (string.byte(rxBuffer, 18) * 256)
      local frameLength = 20 + dataLength
      if #rxBuffer < frameLength then return end

      local frame = string.sub(rxBuffer, 1, frameLength)
      rxBuffer = string.sub(rxBuffer, frameLength + 1)

      if debugRx then print("RX: " .. BytesToHex(frame)) end

      if FrameChecksumValid(frame, dataLength) then
        if pending and RegisterMatches(frame, pending.register) then
          FinishPending(true)
        elseif debugRx then
          print("Valid response received with no matching command in flight")
        end
      elseif debugRx then
        print("Discarded response with invalid checksum")
      end
    end
  end

  local function RestorePendingToQueue()
    ackTimer:Stop()
    if pending then
      table.insert(commandQueue, 1, pending)
      pending = nil
    end
  end

  local function MarkDisconnected(message, state)
    Connected.Boolean = false
    RestorePendingToQueue()
    SetStatus(state or "MISSING", message)
  end

  local function Connect()
    reconnectTimer:Stop()

    if not AutoConnect.Boolean then
      if tcp.IsConnected then tcp:Disconnect() end
      MarkDisconnected("Auto connect disabled", "COMPROMISED")
      return
    end

    local address = IPAddress.String
    local port = math.floor(Port.Value)
    if address == nil or address == "" then
      MarkDisconnected("Enter the MX30 IP address", "FAULT")
      return
    end

    if tcp.IsConnected then tcp:Disconnect() end
    SetStatus("INITIALIZING", "Connecting to " .. address .. ":" .. port)
    LastCommand.String = "Connecting to " .. address .. ":" .. port
    tcp:Connect(address, port)
  end

  reconnectTimer.EventHandler = function()
    reconnectTimer:Stop()
    Connect()
  end

  local function ScheduleReconnect()
    reconnectTimer:Stop()
    reconnectTimer:Start(0.3)
  end

  tcp.EventHandler = function(socket, event, err)
    if event == TcpSocket.Events.Connected then
      Connected.Boolean = true
      SetStatus("OK", "Connected to " .. IPAddress.String .. ":" .. math.floor(Port.Value))
      LastCommand.String = "TCP connected"
      ProcessQueue()

    elseif event == TcpSocket.Events.Reconnect then
      Connected.Boolean = false
      SetStatus("INITIALIZING", "Reconnecting...")

    elseif event == TcpSocket.Events.Data then
      local data = socket:Read(socket.BufferLength)
      if data and #data > 0 then
        rxBuffer = rxBuffer .. data
        ParseFrames()
      end

    elseif event == TcpSocket.Events.Closed then
      MarkDisconnected("Connection closed by MX30", "MISSING")

    elseif event == TcpSocket.Events.Error then
      MarkDisconnected("TCP error: " .. tostring(err or "unknown"), "FAULT")

    elseif event == TcpSocket.Events.Timeout then
      MarkDisconnected("TCP timeout", "FAULT")
    end
  end

  DisplayOn.EventHandler = function(control)
    if not suppressEvents then SetDisplay(control.Boolean) end
  end

  DisplayOnCommand.EventHandler = function()
    SetDisplay(true)
  end

  DisplayOffCommand.EventHandler = function()
    SetDisplay(false)
  end

  DisplayToggleCommand.EventHandler = function()
    SetDisplay(not requestedDisplayOn)
  end

  Brightness.EventHandler = function()
    if suppressEvents then return end
    brightnessTimer:Stop()
    brightnessTimer:Start(0.2)
  end

  for i = 1, 10 do
    local presetNumber = i
    Preset[i].EventHandler = function()
      RecallPreset(presetNumber)
    end
  end

  IPAddress.EventHandler = ScheduleReconnect
  Port.EventHandler = ScheduleReconnect

  AutoConnect.EventHandler = function(control)
    if control.Boolean then
      ScheduleReconnect()
    else
      reconnectTimer:Stop()
      if tcp.IsConnected then tcp:Disconnect() end
      MarkDisconnected("Auto connect disabled", "COMPROMISED")
    end
  end

  Reconnect.EventHandler = function()
    ScheduleReconnect()
  end

  print("NovaStar MX30 COEX plugin v" .. PluginInfo.Version .. " starting")
  Connected.Boolean = false
  CurrentPreset.Value = 0
  LastCommand.String = "Initializing"
  SetStatus("INITIALIZING", "Initializing")

  if AutoConnect.Boolean then
    ScheduleReconnect()
  else
    SetStatus("COMPROMISED", "Auto connect disabled")
  end
end
