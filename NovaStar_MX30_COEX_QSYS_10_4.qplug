--[[
  NovaStar MX30 COEX - Q-SYS plugin
  Version 1.3.0

  Compatible target:
    * Q-SYS Designer / Core OS 10.4
    * NovaStar MX30 using COEX Central Control Protocol V1.5.0
    * TCP port 5200

  Installation:
    1. Double-click this .qplug file, or copy it to:
       Documents\QSC\Q-Sys Designer\Plugins
    2. Restart Q-SYS Designer if the plugin does not appear immediately.
    3. Add "NovaStar MX30 COEX" to the design.
    4. On the Setup page, enter the MX30 IP address. Port 5200 is the default.
    5. In the MX30 menu, enable the Central Control protocol switch.

  Important:
    * ON, OFF and TOGGLE are exposed as separate trigger buttons and input pins.
    * "Display On" selects normal display. Off selects receiving-card blackout.
      It does NOT remove AC power or put the MX30 hardware into standby.
    * Brightness, display and preset feedback are updated only after a valid ACK
      from the MX30. The published V1.5.0 protocol does not define status polling
      for these controls.
    * Presets must already exist in the MX30/VMP project.
--]]

PluginInfo = {
  Name = "NovaStar~MX30 COEX",
  Version = "1.3.0",
  BuildVersion = "1.3.0.0",
  Id = "b2a6fbde-58f8-47da-93da-e68c4f615bd6",
  Author = "iP-Pro | +34 661 845 243",
  Manufacturer = "NovaStar",
  Model = "MX30",
  Description = "iP-Pro driver: controls MX30 brightness, ON/OFF/TOGGLE display blackout and presets 1-10 via the COEX Central Control TCP protocol. Contact: +34 661 845 243."
}

function GetColor(props)
  return { 18, 96, 138 }
end

function GetPrettyName(props)
  return "NovaStar MX30 COEX v" .. PluginInfo.Version
end

PageNames = { "Control", "Setup", "iP-Pro" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  return {
    {
      Name = "Debug Print",
      Type = "enum",
      Choices = { "None", "Tx/Rx", "Tx", "Rx", "All" },
      Value = "None"
    }
  }
end

function RectifyProperties(props)
  if props.plugin_show_debug and props.plugin_show_debug.Value == false then
    props["Debug Print"].IsHidden = true
  end
  return props
end

function GetControls(props)
  local ctrls = {}

  table.insert(ctrls, {
    Name = "Status",
    ControlType = "Indicator",
    IndicatorType = "Status",
    UserPin = true,
    PinStyle = "Output"
  })
  table.insert(ctrls, {
    Name = "Connected",
    ControlType = "Indicator",
    IndicatorType = "Led",
    UserPin = true,
    PinStyle = "Output"
  })
  table.insert(ctrls, {
    Name = "DisplayOn",
    ControlType = "Button",
    ButtonType = "Toggle",
    DefaultValue = true,
    UserPin = true,
    PinStyle = "Both"
  })
  table.insert(ctrls, {
    Name = "DisplayOnCommand",
    ControlType = "Button",
    ButtonType = "Trigger",
    UserPin = true,
    PinStyle = "Input"
  })
  table.insert(ctrls, {
    Name = "DisplayOffCommand",
    ControlType = "Button",
    ButtonType = "Trigger",
    UserPin = true,
    PinStyle = "Input"
  })
  table.insert(ctrls, {
    Name = "DisplayToggleCommand",
    ControlType = "Button",
    ButtonType = "Trigger",
    UserPin = true,
    PinStyle = "Input"
  })
  table.insert(ctrls, {
    Name = "Brightness",
    ControlType = "Knob",
    ControlUnit = "Percent",
    Min = 0,
    Max = 100,
    DefaultValue = 100,
    UserPin = true,
    PinStyle = "Both"
  })
  table.insert(ctrls, {
    Name = "BrightnessFB",
    ControlType = "Knob",
    ControlUnit = "Percent",
    Min = 0,
    Max = 100,
    DefaultValue = 100,
    UserPin = true,
    PinStyle = "Output"
  })
  table.insert(ctrls, {
    Name = "Preset",
    ControlType = "Button",
    ButtonType = "Trigger",
    Count = 10,
    UserPin = true,
    PinStyle = "Input"
  })
  table.insert(ctrls, {
    Name = "CurrentPreset",
    ControlType = "Knob",
    ControlUnit = "Integer",
    Min = 0,
    Max = 10,
    DefaultValue = 0,
    UserPin = true,
    PinStyle = "Output"
  })
  table.insert(ctrls, {
    Name = "LastCommand",
    ControlType = "Text",
    UserPin = true,
    PinStyle = "Output"
  })
  table.insert(ctrls, {
    Name = "IPAddress",
    ControlType = "Text",
    DefaultValue = "192.168.0.10",
    UserPin = true,
    PinStyle = "Both"
  })
  table.insert(ctrls, {
    Name = "Port",
    ControlType = "Knob",
    ControlUnit = "Integer",
    Min = 1,
    Max = 65535,
    DefaultValue = 5200,
    UserPin = true,
    PinStyle = "Both"
  })
  table.insert(ctrls, {
    Name = "AutoConnect",
    ControlType = "Button",
    ButtonType = "Toggle",
    DefaultValue = true,
    UserPin = true,
    PinStyle = "Both"
  })
  table.insert(ctrls, {
    Name = "Reconnect",
    ControlType = "Button",
    ButtonType = "Trigger",
    UserPin = true,
    PinStyle = "Input"
  })

  return ctrls
end

local function AddLabel(graphics, text, x, y, w, h, align, size)
  table.insert(graphics, {
    Type = "Text",
    Text = text,
    Position = { x, y },
    Size = { w, h },
    FontSize = size or 12,
    HTextAlign = align or "Left"
  })
end

-- Embedded JPG supplied by iP-Pro. Keeping it inside the qplug means the
-- branded interface does not depend on an external image file.
local IPPRO_LOGO = [[]]

local function AddBrandFooter(graphics, y)
  AddLabel(graphics, "iP-Pro  |  +34 661 845 243", 18, y, 475, 20, "Center", 11)
end

