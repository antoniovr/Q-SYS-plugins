-- BEGIN include "000_info.lua"
PluginInfo = {
    Name = "Game Boy Emulator",
    Version = "1.0.0",
    BuildVersion = "1.0.0.16",
    Id = "96ee95d7-2a02-4b50-b72a-3a84e5aa1e09",
    Author = "IntegratorBlocks",
    Description = [[A Game Boy (DMG) emulator for Q-SYS. Renders the 160x144 4-color display via SVG. Based on LuaGB architecture, adapted for the Q-SYS Lua 5.3 runtime.]]
}
-- END include "000_info.lua"

-- BEGIN include "011_images.lua"
integratorBlocksAboutBanner = ""

gameboyShellSvg = ""

-- END include "011_images.lua"


function GetColor(props)
  return { 15, 56, 15 }  -- GB darkest green
end

function GetPrettyName(props)
  return "GB Emu v" .. PluginInfo.Version
end

function GetPages(props)
  return {
    { name = "Main" },
    { name = "Save Manager" },
    { name = "About" },
  }
end

function GetProperties()
  local props = {}
  -- BEGIN include "050_properties.lua"
table.insert(props, {
  Name = "Palette",
  Type = "enum",
  Value = "Green",
  Choices = { "Green", "Grayscale", "Classic" },
})

table.insert(props, {
  Name = "Frame Skip",
  Type = "integer",
  Value = 3,
  Min = 1,
  Max = 10,
})

table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Value = "None",
  Choices = { "None", "CPU", "PPU", "All" },
})
-- END include "050_properties.lua"

  return props
end

function RectifyProperties(props)
  return props
end

function GetControls(props)
  local ctrls = {}
  -- BEGIN include "070_controls.lua"
-- Game screen (SVG rendered via Legend property)
table.insert(ctrls, {
  Name = "GameScreen",
  ControlType = "Button",
  ButtonType = "Momentary",
  Count = 1,
})

-- D-Pad buttons
table.insert(ctrls, { Name = "DPadUp",    ControlType = "Button", ButtonType = "Momentary", Count = 1 })
table.insert(ctrls, { Name = "DPadDown",  ControlType = "Button", ButtonType = "Momentary", Count = 1 })
table.insert(ctrls, { Name = "DPadLeft",  ControlType = "Button", ButtonType = "Momentary", Count = 1 })
table.insert(ctrls, { Name = "DPadRight", ControlType = "Button", ButtonType = "Momentary", Count = 1 })
table.insert(ctrls, { Name = "DPadCenter", ControlType = "Button", ButtonType = "Momentary", Count = 1 })

-- Action buttons
table.insert(ctrls, { Name = "ButtonA",      ControlType = "Button", ButtonType = "Momentary", Count = 1 })
table.insert(ctrls, { Name = "ButtonB",      ControlType = "Button", ButtonType = "Momentary", Count = 1 })
table.insert(ctrls, { Name = "ButtonStart",  ControlType = "Button", ButtonType = "Momentary", Count = 1 })
table.insert(ctrls, { Name = "ButtonSelect", ControlType = "Button", ButtonType = "Momentary", Count = 1 })

-- System controls
table.insert(ctrls, { Name = "ResetButton",  ControlType = "Button", ButtonType = "Trigger", Count = 1 })
table.insert(ctrls, { Name = "PowerButton",  ControlType = "Button", ButtonType = "Toggle", Count = 1 })

-- Debug / status
table.insert(ctrls, { Name = "DebugInfo", ControlType = "Indicator", IndicatorType = "Text", Count = 1 })
table.insert(ctrls, { Name = "Status", ControlType = "Indicator", IndicatorType = "Led", Count = 1 })
table.insert(ctrls, { Name = "FPSDisplay", ControlType = "Indicator", IndicatorType = "Text", Count = 1 })
table.insert(ctrls, { Name = "CpuSpeed", ControlType = "Indicator", IndicatorType = "Text", Count = 1 })

-- SRAM persistence (hidden data store - persists in design file)
table.insert(ctrls, { Name = "SramData", ControlType = "Text", TextBoxStyle = "Normal", Count = 1, UserPin = false })
table.insert(ctrls, { Name = "SramAutoSave", ControlType = "Button", ButtonType = "Toggle", Count = 1 })
table.insert(ctrls, { Name = "SramSave", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
table.insert(ctrls, { Name = "SramLoad", ControlType = "Button", ButtonType = "Trigger", Count = 1 })
table.insert(ctrls, { Name = "SramStatus", ControlType = "Indicator", IndicatorType = "Text", Count = 1 })

-- Save states (3 slots - data stored in control string, persists in design file)
table.insert(ctrls, { Name = "SaveStateData", ControlType = "Text", TextBoxStyle = "Normal", Count = 3, UserPin = false })
table.insert(ctrls, { Name = "SaveStateSave", ControlType = "Button", ButtonType = "Trigger", Count = 3 })
table.insert(ctrls, { Name = "SaveStateLoad", ControlType = "Button", ButtonType = "Trigger", Count = 3 })
table.insert(ctrls, { Name = "SaveStateDelete", ControlType = "Button", ButtonType = "Trigger", Count = 3 })
table.insert(ctrls, { Name = "SaveStateInfo", ControlType = "Indicator", IndicatorType = "Text", Count = 3 })
-- END include "070_controls.lua"

  return ctrls
end

function GetControlLayout(props)
  local layout = {}
  local graphics = {}
  -- BEGIN include "080_layout.lua"
local pagenames = {"Main", "Save Manager", "About"}
local CurrentPage = pagenames[props["page_index"].Value]


-- Main Page - Game Boy shell with screen, D-pad, buttons, system controls

if CurrentPage == "Main" then

  -- Plugin dimensions (2x scaled from 299.2 x 426.27 SVG viewBox)
  local PLUGIN_W = 598
  local PLUGIN_H = 853

  -- Color palette
  local Color = {
    screen     = { 15, 56, 15 },      -- GB dark green
    dpad       = { 30, 34, 36 },      -- D-pad resting
    dpad_on    = { 45, 50, 52 },      -- D-pad pressed
    dpad_text  = { 200, 200, 200 },
    ab         = { 139, 92, 246 },    -- purple A/B buttons
    ab_text    = { 26, 26, 26 },
    startsel   = { 85, 87, 83 },      -- Start/Select gray
    ss_text    = { 238, 238, 236 },
    power      = { 0, 120, 0 },
    reset      = { 120, 60, 0 },
    led_on     = { 239, 41, 41 },
    led_off    = { 60, 60, 60 },
    info       = { 60, 60, 60 },
    debug      = { 80, 80, 80 },
  }

  -- Layout regions
  local Screen   = { x = 142, y = 125, w = 320, h = 288 }
  local DPad     = { cx = 140, cy = 580, size = 56, inset = 5 }
  local ABtn     = { x = 470, y = 530 }
  local BBtn     = { x = 390, y = 575 }
  local ABSize   = 64
  local StartSel = { y = 680, selX = 205, staX = 315, w = 90, h = 28 }
  local SysRow   = 68

  -- Arrow glyphs for D-pad legends
  local Arrow = {
    Up    = "\xe2\x96\xb2",  -- triangle up
    Down  = "\xe2\x96\xbc",  -- triangle down
    Left  = "\xe2\x97\x80",  -- triangle left
    Right = "\xe2\x96\xb6",  -- triangle right
  }

  -- Add a button to the layout
  local function addButton(name, opts)
    layout[name] = {
      PrettyName   = opts.pretty or name,
      Style        = "Button",
      ButtonStyle  = opts.style or "Momentary",
      Legend       = opts.legend or "",
      Color        = opts.color,
      OffColor     = opts.offColor,
      StrokeWidth  = opts.strokeWidth,
      FontColor    = opts.fontColor,
      FontSize     = opts.fontSize,
      CornerRadius = opts.radius,
      Position     = opts.pos,
      Size         = opts.size,
      ZOrder       = opts.z or 2,
    }
  end

  -- Add a text display to the layout
  local function addText(name, pretty, pos, size, opts)
    layout[name] = {
      PrettyName = pretty,
      Style      = "Text",
      Position   = pos,
      Size       = size,
      FontSize   = opts and opts.fontSize or 9,
      Color      = opts and opts.color or Color.debug,
      ZOrder     = opts and opts.z or 3,
    }
  end


  -- Shell Background

  table.insert(graphics, {
    Type     = "Svg",
    Image    = gameboyShellSvg,
    Position = { 0, 0 },
    Size     = { PLUGIN_W, PLUGIN_H },
    ZOrder   = 0,
  })


  -- Game Screen

  addButton("GameScreen", {
    pretty = "Game Screen",
    pos    = { Screen.x, Screen.y },
    size   = { Screen.w, Screen.h },
    color  = Color.screen,
    z      = 1,
  })


  -- D-Pad
  -- 4 directional buttons arranged around a center fill piece

  local size   = DPad.size
  local inset  = DPad.inset
  local cx, cy = DPad.cx, DPad.cy

  -- Center cross (non-interactive cosmetic fill)
  addButton("DPadCenter", {
    pretty      = "D-Pad Center",
    pos         = { cx - size/2, cy - size/2 },
    size        = { size, size },
    color       = Color.dpad,
    offColor    = Color.dpad,
    strokeWidth = 0,
    z           = 1,
  })

  -- Directional buttons
  local dirs = {
    { name = "DPadUp",    dir = "Up",    pos = { cx - size/2,          cy - size*1.5 + inset } },
    { name = "DPadDown",  dir = "Down",  pos = { cx - size/2,          cy + size/2   - inset } },
    { name = "DPadLeft",  dir = "Left",  pos = { cx - size*1.5 + inset, cy - size/2           } },
    { name = "DPadRight", dir = "Right", pos = { cx + size/2   - inset, cy - size/2           } },
  }
  for _, d in ipairs(dirs) do
    addButton(d.name, {
      pretty      = "D-Pad " .. d.dir,
      legend      = Arrow[d.dir],
      pos         = d.pos,
      size        = { size, size },
      color       = Color.dpad_on,
      offColor    = Color.dpad,
      strokeWidth = 0,
      fontColor   = Color.dpad_text,
      fontSize    = 16,
    })
  end


  -- A / B Buttons
  -- Purple circles in diagonal layout (like the original DMG)

  for _, b in ipairs({
    { name = "ButtonA", letter = "A", x = ABtn.x, y = ABtn.y },
    { name = "ButtonB", letter = "B", x = BBtn.x, y = BBtn.y },
  }) do
    addButton(b.name, {
      pretty    = b.letter .. " Button",
      legend    = b.letter,
      pos       = { b.x, b.y },
      size      = { ABSize, ABSize },
      color     = Color.ab,
      fontColor = Color.ab_text,
      fontSize  = 20,
      radius    = ABSize / 2,
    })
  end


  -- Start / Select
  -- Pill-shaped buttons centered below the D-pad/AB area

  for _, b in ipairs({
    { name = "ButtonSelect", pretty = "Select", label = "SELECT", x = StartSel.selX },
    { name = "ButtonStart",  pretty = "Start",  label = "START",  x = StartSel.staX },
  }) do
    addButton(b.name, {
      pretty    = b.pretty,
      legend    = b.label,
      pos       = { b.x, StartSel.y },
      size      = { StartSel.w, StartSel.h },
      color     = Color.startsel,
      fontColor = Color.ss_text,
      fontSize  = 10,
      radius    = StartSel.h / 2,
    })
  end


  -- System Controls (top-right)

  addButton("PowerButton", {
    pretty   = "Power",
    legend   = "POWER",
    style    = "Toggle",
    pos      = { 415, 10 },
    size     = { 60, 20 },
    color    = Color.power,
    fontSize = 9,
    z        = 3,
  })

  addButton("ResetButton", {
    pretty   = "Reset",
    legend   = "RESET",
    style    = "Trigger",
    pos      = { 480, 10 },
    size     = { 55, 20 },
    color    = Color.reset,
    fontSize = 9,
    z        = 3,
  })


  -- Status Displays
  -- Small readouts beside and below the game screen

  local statX    = Screen.x + Screen.w + 6
  local statW    = 60
  local statH    = 16

  addText("FPSDisplay", "FPS",
    { statX, Screen.y }, { statW, statH })

  addText("CpuSpeed", "CPU Speed",
    { statX, Screen.y + statH + 1 }, { statW, statH })

  addText("DebugInfo", "Debug Info",
    { Screen.x, Screen.y + Screen.h + 2 }, { Screen.w, 16 })


  -- Power LED
  -- Positioned over the SVG battery indicator dot

  layout["Status"] = {
    PrettyName = "Power LED",
    Style      = "Led",
    Color      = Color.led_on,
    OffColor   = Color.led_off,
    Position   = { 72, 213 },
    Size       = { 28, 28 },
    ZOrder     = 2,
  }


-- Save Manager Page

elseif CurrentPage == "Save Manager" then

  local PAGE_W = 400
  local PAGE_H = 500

  local Color = {
    save     = { 34, 139, 34 },       -- green save buttons
    load     = { 50, 100, 168 },      -- blue load buttons
    delete   = { 139, 34, 34 },       -- red delete buttons
    btntext  = { 240, 240, 240 },
    sram_on  = { 34, 139, 34 },
    sram_off = { 80, 80, 80 },
  }

  local btnW, btnH, btnGap = 110, 28, 15

  -- Helper: add a label to the graphics layer
  local function addLabel(text, x, y, w, h, opts)
    opts = opts or {}
    table.insert(graphics, {
      Type       = "Label",
      Text       = text,
      Font       = opts.font or "Roboto",
      FontSize   = opts.fontSize or 11,
      FontStyle  = opts.bold and "Bold" or nil,
      HTextAlign = opts.align or "Left",
      Position   = { x, y },
      Size       = { w, h },
      ZOrder     = 1,
    })
  end

  -- Helper: add a trigger button with standard Save Manager styling
  local function addBtn(name, pretty, legend, color, pos, opts)
    opts = opts or {}
    layout[name] = {
      PrettyName   = pretty,
      Style        = "Button",
      ButtonStyle  = opts.style or "Trigger",
      Legend       = legend,
      Color        = color,
      OffColor     = opts.offColor,
      FontColor    = Color.btntext,
      FontSize     = 10,
      Position     = pos,
      Size         = opts.size or { btnW, btnH },
      CornerRadius = 4,
      ZOrder       = 2,
    }
  end


  -- Background

  addLabel("SAVE MANAGER", 0, 10, PAGE_W, 30, {
    fontSize = 16, bold = true, align = "Center",
  })


  -- SRAM (Battery Save) Section

  addLabel("SRAM (Battery Save)", 15, 45, 200, 20, {
    fontSize = 12, bold = true,
  })

  layout["SramStatus"] = {
    PrettyName = "SRAM Status",
    Style      = "Text",
    Position   = { 15, 72 },
    Size       = { 370, 20 },
    FontSize   = 9,
    ZOrder     = 1,
  }

  addBtn("SramAutoSave", "SRAM Auto-Save", "AUTO-SAVE",
    Color.sram_on, { 15, 98 },
    { style = "Toggle", offColor = Color.sram_off })

  addBtn("SramSave", "Save SRAM", "SAVE SRAM",
    Color.save, { 15 + btnW + btnGap, 98 })

  addBtn("SramLoad", "Load SRAM", "LOAD SRAM",
    Color.load, { 15 + (btnW + btnGap) * 2, 98 })

  -- Hidden data store (persists SRAM data between sessions)
  layout["SramData"] = {
    PrettyName = "SRAM Data Store",
    Style      = "None",
  }


  -- Save States Section
  table.insert(graphics, {
    Type        = "GroupBox",
    Text        = "",
    StrokeWidth = 1,
    Position    = { 15, 140 },
    Size        = { PAGE_W - 30, 1 },
    ZOrder      = 1,
  })

  addLabel("Save States", 15, 145, 200, 20, {
    fontSize = 12, bold = true,
  })

  -- 3 save slots, each with info display + save/load/delete buttons
  for slot = 1, 3 do
    local y    = 170 + (slot - 1) * 100
    local btnY = y + 24

    -- Slot header
    addLabel("Slot " .. slot, 15, y, 60, 20, {
      fontSize = 11, bold = true,
    })

    -- Slot info (shows timestamp, title, etc.)
    layout["SaveStateInfo " .. slot] = {
      PrettyName = "Save State " .. slot .. " Info",
      Style      = "Text",
      Position   = { 80, y },
      Size       = { 300, 20 },
      FontSize   = 9,
      ZOrder     = 1,
    }

    -- Action buttons
    addBtn("SaveStateSave " .. slot, "Save State " .. slot, "SAVE",
      Color.save, { 15, btnY })

    addBtn("SaveStateLoad " .. slot, "Load State " .. slot, "LOAD",
      Color.load, { 15 + btnW + btnGap, btnY })

    addBtn("SaveStateDelete " .. slot, "Delete State " .. slot, "DELETE",
      Color.delete, { 15 + (btnW + btnGap) * 2, btnY })

    -- Hidden data store (holds serialized state)
    layout["SaveStateData " .. slot] = {
      PrettyName = "Save State " .. slot .. " Data",
      Style      = "None",
    }
  end


-- About Page

elseif CurrentPage == "About" then

  table.insert(graphics, {
    Type     = "Image",
    Image    = integratorBlocksAboutBanner,
    Size     = { 225, 75 },
    Position = { 10, 10 },
  })

  for _, lbl in ipairs({
    { text = "Game Boy Emulator for Q-SYS",  y = 90,  fontSize = 12, font = "Roboto" },
    { text = GetPrettyName(props),            y = 115 },
    { text = "Based on LuaGB (BSD-3-Clause)", y = 145, fontSize = 9 },
  }) do
    table.insert(graphics, {
      Type     = "Label",
      Text     = lbl.text,
      Size     = { 225, lbl.fontSize and 20 or 30 },
      Position = { 10, lbl.y },
      FontSize = lbl.fontSize or 11,
      Font     = lbl.font,
    })
  end

end
-- END include "080_layout.lua"

  return layout, graphics
end

