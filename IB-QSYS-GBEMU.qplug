-- ROM_DATA_END
-- Runtime initialization
if Controls then
-- BEGIN include "130_runtime.lua"
-- Game Boy Emulator - Q-SYS Runtime Integration
-- Bridges emulator core to Q-SYS controls, timers, and display.
-- Multiple CPU timers run at 120Hz each for parallel throughput.
-- State machine: idle -> loading -> ready -> running

-- Control aliases
GameScreen = Controls.GameScreen
DPadUp = Controls.DPadUp
DPadDown = Controls.DPadDown
DPadLeft = Controls.DPadLeft
DPadRight = Controls.DPadRight
ButtonA = Controls.ButtonA
ButtonB = Controls.ButtonB
BtnStart = Controls.ButtonStart
BtnSelect = Controls.ButtonSelect
ResetButton = Controls.ResetButton
PowerButton = Controls.PowerButton
DebugInfo = Controls.DebugInfo
StatusCtrl = Controls.Status
FPSDisplay = Controls.FPSDisplay
CpuSpeed = Controls.CpuSpeed

-- Save/Load controls
SramData = Controls.SramData
SramAutoSave = Controls.SramAutoSave
SramSave = Controls.SramSave
SramLoad = Controls.SramLoad
SramStatus = Controls.SramStatus
SaveStateData = Controls.SaveStateData    -- array[3]
SaveStateSave = Controls.SaveStateSave    -- array[3]
SaveStateLoad = Controls.SaveStateLoad    -- array[3]
SaveStateDelete = Controls.SaveStateDelete -- array[3]
SaveStateInfo = Controls.SaveStateInfo    -- array[3]

emulatorReady = false
emulatorPowered = false
emulatorState = "idle"
cpuTimers = {}           -- N CPU timers, each with independent Q-SYS exec budget
fpsTimer = nil
frameCounter = 0         -- GB frames completed (CPU-side) since last FPS sample
cycleCounter = 0         -- total T-cycles executed since last FPS sample
renderCounter = 0        -- render passes pushed to screen since last FPS sample
lastFPSTime = 0
currentFPS = 0           -- GB frames/sec (CPU throughput)
currentCpuPct = 0        -- % of real GB clock speed (4.194304 MHz)
currentRenderFPS = 0     -- actual screen updates/sec (capped at 30 by control frames)
renderPhase = 0          -- which render step to process next (0..2)
renderInProgress = false -- true while render steps are being processed

-- Speed limiter state: tracks emulated time vs wall-clock time
speedLimitStartTime = 0  -- wall-clock time when emulation started
speedLimitCycles = 0     -- total cycles executed since start

-- Render rate limiter: wall-clock based (independent of emulation speed)
lastRenderTime = 0       -- wall-clock time of last render
renderInterval = 0       -- seconds between renders (1/TARGET_RENDER_FPS)

-- Screen display dimensions (from layout: 320x288 = 2x GB native)
DISPLAY_W = 320
DISPLAY_H = 288

-- Disable auto-GC; we run incremental steps in CPU callbacks instead
collectgarbage("stop")

-- Palette selection
function GetSelectedPalette()
  local palName = Properties["Palette"].Value
  if palName == "Grayscale" then
    return GB_CONFIG.PALETTES.Grayscale
  elseif palName == "Classic" then
    return GB_CONFIG.PALETTES.Classic
  else
    return GB_CONFIG.PALETTES.Green
  end
end

-- Splash screen (shown when no ROM loaded or power off)
function ShowSplashScreen(message)
  local svg = SVG.new(DISPLAY_W, DISPLAY_H)
  svg:rect(0, 0, DISPLAY_W, DISPLAY_H, "#0F380F")
  svg:text(DISPLAY_W / 2, DISPLAY_H / 2 - 20, "GB Emu", "#306230", 20, "middle")
  svg:text(DISPLAY_W / 2, DISPLAY_H / 2 + 4, "Q-SYS Edition", "#306230", 12, "middle")
  if message then
    svg:text(DISPLAY_W / 2, DISPLAY_H / 2 + 40, message, "#8BAC0F", 14, "middle")
  end
  GameScreen.Legend = svg:finish()
end

function ShowPowerOffScreen()
  ShowSplashScreen()
end

function ShowLoadingScreen(progress)
  local svg = SVG.new(DISPLAY_W, DISPLAY_H)
  svg:rect(0, 0, DISPLAY_W, DISPLAY_H, "#0F380F")
  svg:text(DISPLAY_W / 2, DISPLAY_H / 2 - 30, "LOADING...", "#9BBC0F", 20, "middle")
  
  -- Progress bar
  local barW = 200
  local barH = 16
  local barX = (DISPLAY_W - barW) / 2
  local barY = DISPLAY_H / 2
  svg:rect(barX, barY, barW, barH, "#306230")  -- background
  local fillW = mfloor(barW * (progress / 100))
  if fillW > 0 then
    svg:rect(barX, barY, fillW, barH, "#9BBC0F")  -- fill
  end
  
  svg:text(DISPLAY_W / 2, barY + barH + 20, progress .. "%", "#8BAC0F", 10, "middle")
  GameScreen.Legend = svg:finish()
end

-- CpuTick: each CPU timer fires at 120Hz. Handles emulation and render phases.

-- Loading tick: only one CPU timer handles loading (loadingLock prevents races)
function LoadingTick()
  local stillLoading = GAMEBOY.loadChunk()
  local progress = GAMEBOY.getLoadProgress()
  ShowLoadingScreen(progress)
  
  if not stillLoading then
    emulatorReady = true
    
    -- Auto-load SRAM if saved data exists (chunked to avoid exec-limit on 32KB ERAM)
    local sramB64 = SramData.String
    if sramB64 and sramB64 ~= "" then
      emulatorState = "savedata"
      GB_SAVEDATA.startOperation("sram_load", { data = sramB64 }, function(ok, msg)
        SramStatus.String = sformat("Auto-loaded | %s", GB_SAVEDATA.getSRAMInfo(sramB64))
        print("[SRAM] Auto-loaded saved SRAM data (chunked)")
        -- Now transition to ready/running
        FinishPostLoad()
      end)
      return  -- SaveDataTick will handle remaining phases
    end
    
    FinishPostLoad()
  end
end

-- Called after ROM loading (and optional SRAM auto-load) completes
function FinishPostLoad()
  if emulatorPowered then
    emulatorState = "running"
    GAMEBOY.running = true
    StartFPSCounter()
    StatusCtrl.String = "Running"
    print("Chunked loading complete - auto-started")
  else
    emulatorState = "ready"
    StatusCtrl.String = "Ready"
    ShowSplashScreen("PRESS POWER")
    print("Chunked loading complete")
  end
end

-- SaveData tick: processes chunked SRAM/SaveState operations one phase per callback
function SaveDataTick()
  local more = GB_SAVEDATA.processChunk()
  if not more then
    -- Operation complete - callback already fired by _finish().
    -- If emulatorState is still "savedata" (callback didn't change it),
    -- return to running state.
    if emulatorState == "savedata" then
      if emulatorPowered and emulatorReady then
        emulatorState = "running"
        GAMEBOY.running = true
      else
        emulatorState = "ready"
      end
    end
  end
end

-- loadingLock: prevents multiple timers from processing loading/savedata simultaneously
loadingLock = false

-- gcCounter: spread GC steps across callbacks (every 3rd = ~560Hz at 14x120Hz)
gcCounter = 0

-- Pre-computed speed limiter constants
SPEED_FACTOR = GB_CONFIG.CLOCK_SPEED * GB_CONFIG.TARGET_SPEED_PCT / 100
DRIFT_CAP = GB_CONFIG.CLOCK_SPEED / 10  -- 100ms worth of drift
CYCLES_BUDGET = GB_CONFIG.CYCLES_PER_TICK
DEBUG_ON = GB_CONFIG.DEBUG_ENABLED

function CpuTick()
  if emulatorState == "loading" or emulatorState == "savedata" then
    if loadingLock then return end
    loadingLock = true
    local ok, err
    if emulatorState == "loading" then
      ok, err = pcall(LoadingTick)
    else
      ok, err = pcall(SaveDataTick)
    end
    loadingLock = false
    if not ok then
      print("[GB] SaveData/Loading error: " .. tostring(err))
      -- Abort the operation and return to running if possible
      if GB_SAVEDATA.isBusy() then
        GB_SAVEDATA._finish(false, "Error: " .. tostring(err))
      end
      if emulatorState == "savedata" then
        if emulatorPowered and emulatorReady then
          emulatorState = "running"
          GAMEBOY.running = true
        else
          emulatorState = "ready"
        end
      end
    end
    return
  end
  
  if emulatorState ~= "running" or not emulatorPowered then return end
  
  -- Render-only path: when render is in progress, do render work only
  if renderInProgress then
    local more = GAMEBOY.renderChunk()
    if not more then
      local legend = GAMEBOY.renderFinalize()
      if legend then
        GameScreen.Legend = legend
        renderCounter = renderCounter + 1
      end
      renderInProgress = false
    end
    return
  end
  
  -- Speed limiter: calculate how many cycles we're allowed to run
  local now = Timer.Now()
  local elapsedWall = now - speedLimitStartTime
  local targetCycles = elapsedWall * SPEED_FACTOR
  local deficit = targetCycles - speedLimitCycles
  
  -- Drift cap: reset baseline if too far off target
  if deficit < -DRIFT_CAP or deficit > DRIFT_CAP then
    speedLimitStartTime = now
    speedLimitCycles = 0
    deficit = 0  -- will skip this tick (< 456), next tick runs normally
  end
  
  -- Skip if ahead of target or deficit too small
  if deficit < 456 then
    return
  end
  
  -- Cap budget at configured max, but only run what's needed to stay on target
  local budget = deficit < CYCLES_BUDGET and mfloor(deficit) or CYCLES_BUDGET
  
  -- Reserve cycles before running (prevents race with parallel timers)
  speedLimitCycles = speedLimitCycles + budget
  
  -- Normal CPU path: run the calculated budget.
  local ok, cyclesOrErr, framesCompleted = pcall(GAMEBOY.stepBudget, budget)
  if not ok then
    -- Exec-limit kills produce "Max execution limits exceeded" or "cannot resume".
    -- Recover partial progress from CPU checkpoint, then continue normally.
    local msg = tostring(cyclesOrErr)
    if not msg:find("dead coroutine") and not msg:find("cannot resume")
       and not msg:find("execution limit") and not msg:find("Max execution") then
      print("[GB] CPU error: " .. msg)
      return
    end
    -- Recover frame-tracking state from last checkpoint
    cyclesOrErr, framesCompleted = GAMEBOY.recoverFromExecLimit()
    -- Roll back PPU state to match checkpoint
    local cpu_chk = GB_CPU
    if cpu_chk._chkPpuLy then
      GB_PPU.ly = cpu_chk._chkPpuLy
      GB_PPU.modeCycles = cpu_chk._chkPpuMC
      GB_PPU.mode = cpu_chk._chkPpuMode
      GB_PPU.windowLine = cpu_chk._chkPpuWinLine
    end
    -- Roll back timer state
    if cpu_chk._chkDivCtr then
      GB_TIMER.divCounter = cpu_chk._chkDivCtr
      GB_TIMER.tima = cpu_chk._chkTima
      GB_TIMER.timaCounter = cpu_chk._chkTimaCtr
    end
    -- Roll back interrupt flags to match checkpoint.
    if cpu_chk._chkIFlags then
      GB_INTERRUPTS.flags = cpu_chk._chkIFlags
    end
    -- Re-sync ERAM bank (may have been partial due to exec-limit)
    GB_MEMORY.syncERAMBank(GB_MEMORY.eramBank)
  end
  local cyclesRun = cyclesOrErr
  
  -- Accumulate cycles for FPS% calculation
  -- Adjust speedLimitCycles if we ran fewer cycles than reserved (exec-limit kill)
  cycleCounter = cycleCounter + cyclesRun
  if cyclesRun < budget then
    speedLimitCycles = speedLimitCycles - (budget - cyclesRun)
  end
  
  -- Incremental GC: 14 timers x 120Hz = 1680 callbacks/sec.
  -- SVG pipeline generates ~4-5 MB/sec of string garbage. step(200) at
  -- ~560Hz (~every 3rd callback) provides ~112 MB/sec collection capacity.
  gcCounter = gcCounter + 1
  if gcCounter >= 3 then
    collectgarbage("step", 200)
    gcCounter = 0
  end
  
  -- Track completed frames
  if framesCompleted > 0 then
    frameCounter = frameCounter + framesCompleted
    
    -- Render when the PPU has fresh pixel data and enough wall-clock time has passed
    local timeSinceRender = now - lastRenderTime
    if GB_PPU.renderReady and timeSinceRender >= renderInterval and not renderInProgress then
      GB_PPU.renderReady = false
      lastRenderTime = now
      -- Signal render. Do NOT render in this callback - we already ran
      -- ~12288 CPU cycles, adding tile work would exceed the ~5ms limit.
      -- The next CpuTick callback will enter the render-only path.
      renderInProgress = true
      GB_CONFIG.ACTIVE_PALETTE = GetSelectedPalette()
      GAMEBOY.renderStart()
    end
    
  end
end

-- Timer setup: only CPU timers are needed now. Rendering piggybacks on CPU callbacks.
function StartGameTimer()
  -- Stop existing timers
  for i = 1, #cpuTimers do
    cpuTimers[i]:Stop()
    cpuTimers[i] = nil
  end
  
  -- Reset state
  renderInProgress = false
  
  -- Initialize speed limiter
  speedLimitStartTime = Timer.Now()
  speedLimitCycles = 0
  
  -- Initialize render rate limiter
  lastRenderTime = Timer.Now()
  renderInterval = 1.0 / GB_CONFIG.TARGET_RENDER_FPS
  
  local cpuInterval = 1.0 / GB_CONFIG.TICK_RATE
  local cpuCount = GB_CONFIG.CPU_TIMER_COUNT
  
  -- Create N CPU timers - Q-SYS gives each timer its own ~5ms exec budget,
  -- so N timers = Nx the throughput of a single timer.
  -- Rendering is embedded in these callbacks (no separate render timers).
  for i = 1, cpuCount do
    cpuTimers[i] = Timer.New()
    cpuTimers[i].EventHandler = CpuTick
    cpuTimers[i]:Start(cpuInterval)
  end
  
  local totalCycles = GB_CONFIG.CYCLES_PER_TICK * GB_CONFIG.TICK_RATE * cpuCount
  local theoreticalFPS = totalCycles / GB_CONFIG.CYCLES_PER_FRAME
  print(sformat("%dx CPU @ %dHz (%d cyc/tick, render-inline) = %d cyc/sec (~%.0f FPS)",
    cpuCount, GB_CONFIG.TICK_RATE, GB_CONFIG.CYCLES_PER_TICK,
    totalCycles, theoreticalFPS))
end

function StopEmulation()
  for i = 1, #cpuTimers do
    if cpuTimers[i] then cpuTimers[i]:Stop(); cpuTimers[i] = nil end
  end
  emulatorState = "idle"
  GAMEBOY.running = false
end

-- FPS counter
function StartFPSCounter()
  if fpsTimer then 
    fpsTimer:Stop()
  end
  
  fpsTimer = Timer.New()
  lastFPSTime = Timer.Now()
  frameCounter = 0
  cycleCounter = 0
  renderCounter = 0
  
  fpsTimer.EventHandler = function()
    local now = Timer.Now()
    local elapsed = now - lastFPSTime
    if elapsed > 0 then
      -- GB frames completed per second (CPU throughput)
      currentFPS = frameCounter / elapsed
      -- Percentage of real Game Boy clock speed (4,194,304 Hz)
      currentCpuPct = (cycleCounter / elapsed) / GB_CONFIG.CLOCK_SPEED * 100
      -- Actual screen refreshes per second (capped at 30 by Q-SYS control frames)
      currentRenderFPS = renderCounter / elapsed
    end
    FPSDisplay.String = sformat("%.1f fps", currentRenderFPS)
    CpuSpeed.String = sformat("CPU %.0f%%", currentCpuPct)
    -- Debug info: update once per second (zero hot-path cost)
    if DEBUG_ON then
      DebugInfo.String = GAMEBOY.getStatus()
    end
    frameCounter = 0
    cycleCounter = 0
    renderCounter = 0
    lastFPSTime = now
  end
  fpsTimer:Start(1.0)  -- Update metrics every second
end

-- Input mapping: The Game Boy has an 8-button joypad: D-pad (up/down/left/right) + A, B,
-- Start, Select. Each Q-SYS button fires press/release via event handlers.
-- GB_INPUT translates these into the joypad register (FF00h) bit states.
DPadUp.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("up") else GB_INPUT.release("up") end
end

DPadDown.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("down") else GB_INPUT.release("down") end
end

DPadLeft.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("left") else GB_INPUT.release("left") end
end

DPadRight.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("right") else GB_INPUT.release("right") end
end

ButtonA.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("a") else GB_INPUT.release("a") end
end

ButtonB.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("b") else GB_INPUT.release("b") end
end

BtnStart.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("start") else GB_INPUT.release("start") end
end

BtnSelect.EventHandler = function(ctrl)
  if ctrl.Boolean then GB_INPUT.press("select") else GB_INPUT.release("select") end
end

-- Power and reset controls
PowerButton.EventHandler = function(ctrl)
  if ctrl.Boolean then
    -- Power ON (fresh boot)
    emulatorPowered = true
    StatusCtrl.Boolean = true
    if ROM_DATA and #ROM_DATA > 0 then
      DoReset()
      StartGameTimer()
      StartFPSCounter()
    else
      ShowSplashScreen("NO ROM")
      StatusCtrl.String = "No ROM loaded"
    end
  else
    -- Power OFF (full shutdown â€” stops all timers, resets emulator)
    emulatorPowered = false
    StatusCtrl.Boolean = false

    -- Auto-save SRAM before shutdown
    if emulatorState == "running" and SramAutoSave.Boolean and not GB_SAVEDATA.isBusy() then
      GAMEBOY.running = false
      emulatorState = "savedata"
      GB_SAVEDATA.startOperation("sram_save", {}, function(b64, msg)
        if b64 then
          SramData.String = b64
          SramStatus.String = sformat("Power-off saved | %s", GB_SAVEDATA.getSRAMInfo(b64))
          print("[SRAM] Saved on power-off")
        end
        StopEmulation()
      end)
    else
      StopEmulation()
    end

    if fpsTimer then fpsTimer:Stop() end
    ShowSplashScreen("PRESS POWER")
    FPSDisplay.String = "-- fps"
    CpuSpeed.String = "CPU --%"
    StatusCtrl.String = "Power Off"
  end
end

ResetButton.EventHandler = function(ctrl)
  if (emulatorState == "running" or emulatorState == "ready") and emulatorPowered then
    -- Auto-save SRAM before reset (chunked), then do the actual reset
    if SramAutoSave.Boolean and emulatorState == "running" and not GB_SAVEDATA.isBusy() then
      GAMEBOY.running = false
      emulatorState = "savedata"
      GB_SAVEDATA.startOperation("sram_save", {}, function(b64, msg)
        if b64 then
          SramData.String = b64
          print("[SRAM] Saved before reset")
        end
        -- Now perform the reset
        DoReset()
      end)
    else
      DoReset()
    end
  end
end

function DoReset()
  GAMEBOY.init(
    ROM_DATA,
    nil,
    GetSelectedPalette(),
    GB_CONFIG.FRAME_SKIP,
    Properties["Debug Print"].Value
  )
  emulatorState = "loading"
  StatusCtrl.String = "Resetting..."
  ShowLoadingScreen(0)
  print("Emulator reset (chunked)")
end

-- SRAM and Save State management (chunked).
-- All save/load operations use GB_SAVEDATA's chunked state machine.
-- Game is paused during operations; CpuTick drives chunk processing via
-- SaveDataTick when emulatorState == "savedata".

-- SRAM auto-save timer (saves every 30 seconds when enabled + running)
sramAutoSaveTimer = nil
SRAM_AUTO_SAVE_INTERVAL = 30  -- seconds

function StartSRAMAutoSave()
  if sramAutoSaveTimer then sramAutoSaveTimer:Stop() end
  sramAutoSaveTimer = Timer.New()
  sramAutoSaveTimer.EventHandler = function()
    if emulatorState == "running" and SramAutoSave.Boolean then
      StartSRAMSave("auto")
    end
  end
  sramAutoSaveTimer:Start(SRAM_AUTO_SAVE_INTERVAL)
end

-- Start a chunked SRAM save. source = "auto", "manual", "poweroff", "reset"
function StartSRAMSave(source)
  if GB_SAVEDATA.isBusy() then return end  -- already saving/loading
  if emulatorState ~= "running" and source ~= "poweroff" and source ~= "reset" then return end

  GAMEBOY.running = false
  emulatorState = "savedata"

  GB_SAVEDATA.startOperation("sram_save", {}, function(b64, msg)
    if b64 then
      SramData.String = b64
      local prefix = source == "auto" and "Auto-saved" or "Saved"
      SramStatus.String = sformat("%s | %s", prefix, GB_SAVEDATA.getSRAMInfo(b64))
      print(sformat("[SRAM] %s (%d chars)", prefix, #b64))
    else
      SramStatus.String = msg or "No SRAM data"
    end
    -- State transition back to running is handled by SaveDataTick
  end)
end

-- Start a chunked SRAM load
function StartSRAMLoad()
  if GB_SAVEDATA.isBusy() then return end
  local b64 = SramData.String
  if not b64 or b64 == "" then
    SramStatus.String = "No SRAM data to load"
    return
  end

  GAMEBOY.running = false
  emulatorState = "savedata"

  GB_SAVEDATA.startOperation("sram_load", { data = b64 }, function(ok, msg)
    if ok then
      SramStatus.String = sformat("Loaded | %s", GB_SAVEDATA.getSRAMInfo(b64))
      print("[SRAM] Loaded successfully (chunked)")
    else
      SramStatus.String = msg or "Load failed"
    end
  end)
end

-- Update save state info displays (lightweight, no chunking needed)
function RefreshSaveStateInfo()
  for i = 1, 3 do
    SaveStateInfo[i].String = GB_SAVEDATA.getSaveStateInfo(SaveStateData[i].String)
  end
  SramStatus.String = GB_SAVEDATA.getSRAMInfo(SramData.String)
end

-- SRAM event handlers
SramSave.EventHandler = function()
  StartSRAMSave("manual")
end

SramLoad.EventHandler = function()
  StartSRAMLoad()
end

-- Save State event handlers (3 slots)
for i = 1, 3 do
  SaveStateSave[i].EventHandler = function()
    if emulatorState ~= "running" then
      SaveStateInfo[i].String = "Cannot save - emulator not running"
      return
    end
    if GB_SAVEDATA.isBusy() then
      SaveStateInfo[i].String = "Operation in progress..."
      return
    end
    -- Pause game for clean snapshot
    GAMEBOY.running = false
    emulatorState = "savedata"
    SaveStateInfo[i].String = "Saving..."

    GB_SAVEDATA.startOperation("state_save", {}, function(b64, msg)
      if b64 then
        SaveStateData[i].String = b64
        SaveStateInfo[i].String = GB_SAVEDATA.getSaveStateInfo(b64)
        print(sformat("[SaveState] Slot %d saved (%d KB)", i, math.floor(#b64 * 3 / 4 / 1024)))
      else
        SaveStateInfo[i].String = "Save failed: " .. (msg or "unknown")
      end
      -- SaveDataTick handles state transition back to running
    end)
  end

  SaveStateLoad[i].EventHandler = function()
    local b64 = SaveStateData[i].String
    if not b64 or b64 == "" then
      SaveStateInfo[i].String = "Empty - nothing to load"
      return
    end
    if emulatorState ~= "running" and emulatorState ~= "ready" then
      SaveStateInfo[i].String = "Cannot load - emulator not ready"
      return
    end
    if GB_SAVEDATA.isBusy() then
      SaveStateInfo[i].String = "Operation in progress..."
      return
    end
    -- Pause game for clean load
    GAMEBOY.running = false
    emulatorState = "savedata"
    SaveStateInfo[i].String = "Loading..."

    GB_SAVEDATA.startOperation("state_load", { data = b64 }, function(ok, msg)
      if ok then
        -- Reset speed limiter to avoid desync after state restore
        speedLimitStartTime = Timer.Now()
        speedLimitCycles = 0
        renderInProgress = false
        SaveStateInfo[i].String = sformat("Loaded! | %s", GB_SAVEDATA.getSaveStateInfo(b64))
        print(sformat("[SaveState] Slot %d loaded", i))
      else
        SaveStateInfo[i].String = "Load failed: " .. (msg or "unknown")
        print(sformat("[SaveState] Slot %d load failed: %s", i, msg or "unknown"))
      end
      -- SaveDataTick handles state transition back to running
    end)
  end

  SaveStateDelete[i].EventHandler = function()
    SaveStateData[i].String = ""
    SaveStateInfo[i].String = "Empty"
    print(sformat("[SaveState] Slot %d deleted", i))
  end
end

-- Initialization: Called once at plugin startup. Loads ROM data (if embedded
-- via manage_rom.ps1), kicks off the chunked loading state machine, and starts
-- the CPU + render timer array.
function Initialize()
  print("Game Boy Emulator initializing...")
  
  -- Start with power OFF so button doesn't get stuck
  PowerButton.Boolean = false
  emulatorPowered = false
  StatusCtrl.Boolean = false
  ShowPowerOffScreen()
  
  FPSDisplay.String = "-- fps"
  CpuSpeed.String = "CPU --%"
  DebugInfo.String = ""
  
  -- Initialize save state info displays
  RefreshSaveStateInfo()
  
  -- Default auto-save ON (preserves user toggle if already set)
  if SramAutoSave.Boolean == false and SramData.String == "" then
    SramAutoSave.Boolean = true
  end
  StartSRAMAutoSave()
  
  -- Check if ROM data is available (baked into .qplug by manage_rom.ps1)
  -- B64 data is NOT decoded here - it's chunked across timer callbacks by GAMEBOY.loadChunk()
  -- to stay within Q-SYS's ~5ms per-callback exec limit (a 1MB ROM = 1.37MB B64).
  local hasB64 = ROM_DATA_B64 and #ROM_DATA_B64 > 0
  local hasROM = ROM_DATA and #ROM_DATA > 0
  
  if hasB64 or hasROM then
    if hasB64 then
      print(sformat("ROM B64 data found: %d chars (will decode in chunks)", #ROM_DATA_B64))
    else
      print(sformat("ROM data found: %d bytes", #ROM_DATA))
    end
    
    -- Lightweight init - queues chunked loading phases (heavy work deferred to timer callbacks)
    -- If B64 data exists, pass it for chunked decode; otherwise pass decoded ROM directly.
    GAMEBOY.init(
      hasROM and ROM_DATA or nil,
      hasB64 and ROM_DATA_B64 or nil,
      GetSelectedPalette(),
      Properties["Frame Skip"].Value,
      Properties["Debug Print"].Value
    )
    ROM_DATA_B64 = nil  -- GAMEBOY now owns the B64 data
    
    -- Apply frame skip to config
    GB_CONFIG.FRAME_SKIP = Properties["Frame Skip"].Value or 1
    
    -- Enter loading state - CpuTick() will drive chunk processing via LoadingTick()
    emulatorState = "loading"
    StatusCtrl.String = "Loading..."
    ShowLoadingScreen(0)
    
    -- Start timers immediately - CpuTick handles both loading and running states
    StartGameTimer()
  else
    print("No ROM data embedded - use manage_rom.ps1 to inject a ROM")
    emulatorState = "idle"
    emulatorReady = false
    ShowSplashScreen("NO ROM")
    StatusCtrl.String = "No ROM loaded"
  end
end

Initialize()
-- END include "130_runtime.lua"

end

